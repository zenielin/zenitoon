rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 제니툰 회차별 조회수·도움됐어요 — 누구나 읽기, 1씩 증가만 허용
    match /zenitoon_stats/{ep} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['views','likes'])
        && request.resource.data.views is int && request.resource.data.likes is int
        && request.resource.data.views + request.resource.data.likes == 1;
      allow update: if request.resource.data.keys().hasOnly(['views','likes'])
        && ((request.resource.data.views == resource.data.views + 1 && request.resource.data.likes == resource.data.likes)
         || (request.resource.data.likes == resource.data.likes + 1 && request.resource.data.views == resource.data.views));
    }
    // 제니툰 상담 문의 — 쓰기만 허용, 공개 읽기 금지(콘솔·관리자만 조회)
    match /zenitoon_consults/{id} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['company','name','phone','type','message','from_page','createdAt','status'])
        && request.resource.data.company is string && request.resource.data.company.size() <= 100
        && request.resource.data.name is string && request.resource.data.name.size() <= 50
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30
        && request.resource.data.message is string && request.resource.data.message.size() <= 3000
        && request.resource.data.createdAt == request.time;
    }
  }
}
